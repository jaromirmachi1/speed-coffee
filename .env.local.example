# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sanity CMS (when set, shop products and orders use Sanity instead of Supabase for catalog)
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# Stripe (test keys for local development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMTP (order confirmations + rental inquiry notifications)
# Common ports: 587 (STARTTLS), 465 (SSL)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
CONTACT_FROM=orders@speedcoffee.shop
CONTACT_TO=hello@yourdomain.com

# Optional storefront gate (checkout is open unless set to false)
NEXT_PUBLIC_STORE_OPEN=true
